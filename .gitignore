# PokePoke runtime state — blanket-ignore all JSON/JSONL/tmp files to prevent
# operational state from being accidentally committed (config.yaml is YAML, stays tracked)
.pokepoke/*.json
.pokepoke/*.jsonl
.pokepoke/*.tmp
.maintenance_state.json
.pokepoke/locks/
.pokepoke/stats/

# PokePoke logs
.pokepoke/logs/
logs/

# Beads runtime files
bd_list.json
.beads/daemon-*.log.gz
.beads/bd.sock.startlock
.beads/bd.sock
.beads/*.lock
.beads/daemon.lock
.beads/daemon.pid
.beads/beads.db-shm
.beads/beads.db-wal
.beads/sync-state.json

# PokePoke sessions
.pokepoke/sessions/

# Work artifacts (configurable via work_artifacts_dir in .pokepoke/config.yaml)
ai_incident_reports/

# Built frontend assets (regenerated by build_frontend.py / npm run build)
src/pokepoke/static/assets/
src/pokepoke/static/index.html
src/pokepoke/static/vite.svg

